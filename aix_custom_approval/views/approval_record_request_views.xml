<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         l4e.approval.record.request — List View
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="l4e_approval_record_request_view_list" model="ir.ui.view">
        <field name="name">l4e.approval.record.request.list</field>
        <field name="model">l4e.approval.record.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests"
                  decoration-warning="state == 'pending'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'refused'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="rule_id"/>
                <field name="res_model" string="Model"/>
                <field name="res_name" string="Record"/>
                <field name="requester_id"/>
                <field name="date_request"/>
                <field name="approved_count" string="Approved"/>
                <field name="pending_count" string="Pending"/>
                <field name="refused_count" string="Refused"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'refused'"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         l4e.approval.record.request — Form View
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="l4e_approval_record_request_view_form" model="ir.ui.view">
        <field name="name">l4e.approval.record.request.form</field>
        <field name="model">l4e.approval.record.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn-success"
                            invisible="not can_approve or state != 'pending'"
                            confirm="Confirm approval? This action cannot be undone."/>
                    <button name="action_refuse"
                            type="object"
                            string="Refuse"
                            class="btn-danger"
                            invisible="not can_approve or state != 'pending'"/>
                    
                    <button name="action_query"
                        type="object"
                        string="Raise Query"
                        class="btn-warning"
                        invisible="(not can_approve and not is_admin) or state not in ('pending', 'approved', 'refused')"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel Request"
                            invisible="state != 'pending'"
                            groups="base.group_system"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,refused"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_record" type="object"
                                class="oe_stat_button" icon="fa-external-link">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Open Record</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Request Details">
                            <field name="rule_id" readonly="1"/>
                            <field name="res_model" readonly="1" string="Model"/>
                            <field name="res_name" readonly="1" string="Record"/>
                            <field name="requester_id" readonly="1"/>
                            <field name="date_request" readonly="1"/>
                        </group>
                        <group string="Approval Summary">
                            <field name="approval_mode" readonly="1"/>
                            <field name="approved_count" readonly="1"/>
                            <field name="pending_count" readonly="1"/>
                            <field name="refused_count" readonly="1"/>
                            <field name="waiting_count" readonly="1"
                                   invisible="approval_mode != 'sequential'"/>
                        </group>

                        <group string="Query Details">
                                <field name="query_sale_comment" readonly="1"/>
                        </group>
                    </group>

                    <!-- Approval note from rule -->
                    <group string="Approval Instructions"
                           invisible="not rule_note">
                        <field name="rule_note" readonly="1" widget="html" nolabel="1"/>
                    </group>

                    <!-- Approver Lines -->
                    <notebook>
                        <page string="Approvers" name="approvers">
                            <field name="approver_ids" readonly="1">
                                <list string="Approvers"
                                      decoration-success="status == 'approved'"
                                      decoration-danger="status == 'refused'"
                                      decoration-warning="status == 'pending'"
                                      decoration-muted="status == 'waiting'">
                                    <field name="sequence" string="Level"/>
                                    <field name="user_id"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'approved'"
                                           decoration-danger="status == 'refused'"
                                           decoration-warning="status == 'pending'"
                                           decoration-muted="status == 'waiting'"/>
                                    <field name="date"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         l4e.approval.record.request — Search View
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="l4e_approval_record_request_view_search" model="ir.ui.view">
        <field name="name">l4e.approval.record.request.search</field>
        <field name="model">l4e.approval.record.request</field>
        <field name="arch" type="xml">
            <search string="Approval Requests">
                <field name="name"/>
                <field name="rule_id"/>
                <field name="requester_id"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Refused" name="refused" domain="[('state', '=', 'refused')]"/>
                <separator/>
                <filter string="My Requests" name="my_requests"
                        domain="[('requester_id', '=', uid)]"/>
                <filter string="Waiting My Approval" name="my_approval"
                        domain="[('approver_ids.user_id', '=', uid), ('approver_ids.status', '=', 'pending'), ('state', '=', 'pending')]"/>
                <separator/>
                <filter string="Group by Rule" name="by_rule" context="{'group_by': 'rule_id'}"/>
                <filter string="Group by Model" name="by_model" context="{'group_by': 'res_model'}"/>
                <filter string="Group by Status" name="by_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         Actions
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="action_l4e_approval_record_request" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">l4e.approval.record.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No approval requests yet</p>
            <p>Approval requests appear here when a configured rule is triggered.</p>
        </field>
    </record>

    <!-- My Pending Approvals action -->
    <record id="action_l4e_my_pending_approvals" model="ir.actions.act_window">
        <field name="name">My Pending Approvals</field>
        <field name="res_model">l4e.approval.record.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('approver_ids.user_id', '=', uid),
            ('approver_ids.status', '=', 'pending'),
            ('state', '=', 'pending')
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">All caught up!</p>
            <p>No approval requests are waiting for your action.</p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         Menu items
    ══════════════════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_l4e_approval_requests"
              name="All Requests"
              parent="menu_l4e_approval_root"
              action="action_l4e_approval_record_request"
              sequence="20"
              groups="base.group_system"/>

    <menuitem id="menu_l4e_my_pending_approvals"
              name="My Pending Approvals"
              parent="menu_l4e_approval_root"
              action="action_l4e_my_pending_approvals"
              sequence="5"/>

    <!-- ══════════════════════════════════════════════════════════════════════
         Smart button injections for Sale Order, Purchase Order, Invoice
    ══════════════════════════════════════════════════════════════════════════ -->

    <!-- Sale Order smart button -->
    <record id="sale_order_view_form_l4e_approval_btn" model="ir.ui.view">
        <field name="name">sale.order.view.form.l4e.approval.btn</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_l4e_approvals" type="object"
                        class="oe_stat_button" icon="fa-check-circle"
                        invisible="l4e_approval_count == 0">
                    <field name="l4e_approval_count" widget="statinfo" string="Approvals"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order smart button -->
    <record id="purchase_order_view_form_l4e_approval_btn" model="ir.ui.view">
        <field name="name">purchase.order.view.form.l4e.approval.btn</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_l4e_approvals" type="object"
                        class="oe_stat_button" icon="fa-check-circle"
                        invisible="l4e_approval_count == 0">
                    <field name="l4e_approval_count" widget="statinfo" string="Approvals"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Invoice / Journal Entry smart button -->
    <record id="account_move_view_form_l4e_approval_btn" model="ir.ui.view">
        <field name="name">account.move.view.form.l4e.approval.btn</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_l4e_approvals" type="object"
                        class="oe_stat_button" icon="fa-check-circle"
                        invisible="l4e_approval_count == 0">
                    <field name="l4e_approval_count" widget="statinfo" string="Approvals"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- CRM Lead / Opportunity smart button -->
    <record id="crm_opportunity_view_form_l4e_approval_btn" model="ir.ui.view">
        <field name="name">crm.opportunity.view.form.l4e.approval.btn</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_l4e_approvals" type="object"
                        class="oe_stat_button" icon="fa-check-circle"
                        invisible="l4e_approval_count == 0">
                    <field name="l4e_approval_count" widget="statinfo" string="Approvals"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- ── Payment (account always installed) ────────────────────────────── -->
    <record id="account_payment_view_form_l4e_approval_btn" model="ir.ui.view">
        <field name="name">account.payment.view.form.l4e.approval.btn</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_l4e_approvals" type="object"
                        class="oe_stat_button" icon="fa-check-circle"
                        invisible="l4e_approval_count == 0">
                    <field name="l4e_approval_count" widget="statinfo" string="Approvals"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- stock.picking, project.task, hr.expense.sheet, hr.leave
         smart buttons are in bridge modules:
         l4e_approval_inventory, l4e_approval_project, l4e_approval_hr -->

</odoo>
