<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <record id="view_sale_custom_raise_query_form" model="ir.ui.view">
        <field name="name">sale.custom.raise.query.form</field>
        <field name="model">approval.raise.query</field>
        <field name="arch" type="xml">

            <form string="Raise Query">

                <group>
                    <field name="sale_raise_comment" placeholder="Enter your query or suggestion here..."/>
                </group>

                <footer>

                    <button name="action_send_raise_query"
                            string="Send"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>
            </form>

        </field>
    </record>
</odoo>