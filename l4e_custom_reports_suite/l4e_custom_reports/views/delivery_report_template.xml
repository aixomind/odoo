<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_custom_l4e" inherit_id="stock.report_delivery_document">
        <!-- Wrap in custom external layout supporting company custom header/footer images -->
        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-call">l4e_custom_reports_suite.custom_external_layout</attribute>
        </xpath>

        <xpath expr="//div[hasclass('page')]" position="replace">
            <t t-set="doc" t-value="o"/>
            <t t-set="comp" t-value="doc and 'company_id' in doc._fields and doc.company_id or env.company"/>
            <t t-set="text_col" t-value="comp and comp.report_text_color or '#000000'"/>
            <t t-set="table_col" t-value="comp and comp.report_table_color or '#dcdcdc'"/>
            <t t-set="banner_col" t-value="comp and comp.report_text_bg_color or '#dcdcdc'"/>
            <div class="page" t-attf-style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; color: #{text_col}; font-size: 14px; line-height: 1.45;">

                <!-- 1. Header Title Banner, Reference & QR Code -->
                <div class="row mb-3 align-items-center">
                    <div class="col-7">
                        <div t-attf-style="background-color: #{banner_col}; color: #{text_col}; padding: 4px 12px; display: inline-block; font-weight: 900; font-size: 21px; letter-spacing: 0.5px; border-radius: 0px;">
                            DELIVERY NOTE
                        </div>
                        <div t-attf-style="font-size: 17px; font-weight: bold; margin-top: 4px; color: #{text_col};">
                            <span t-field="doc.name"/>
                        </div>
                    </div>
                    <div class="col-5 text-end" id="qrcode">
                        <img t-if="doc.name" t-att-src="'/report/barcode/?barcode_type=QR&amp;value=' + doc.name + '&amp;width=90&amp;height=90'" style="max-height: 90px; max-width: 90px;"/>
                    </div>
                </div>

                <!-- Hidden anchor elements for standard Odoo child view xpaths -->
                <div class="d-none" style="display: none !important;">
                    <div id="informations"/>
                    <div id="total"/>
                    <p name="comment"/>
                    <p name="note"/>
                </div>

                <!-- 2. Source / Warehouse Address (From) & Delivery Address (To) Section -->
                <div class="row mb-3" style="font-size: 14px;">
                    <!-- Left: From Address (Company / Warehouse) -->
                    <div class="col-6">
                        <div t-attf-style="font-weight: 900; font-size: 15.5px; margin-bottom: 3px; color: #{text_col};">From Address :</div>
                        <div style="padding-left: 8px;">
                            <div t-if="doc.picking_type_id and doc.picking_type_id.warehouse_id" t-attf-style="font-weight: bold; text-transform: uppercase; font-size: 15px; color: #{text_col};" t-field="doc.picking_type_id.warehouse_id.name"/>
                            <div t-else="" t-attf-style="font-weight: bold; text-transform: uppercase; font-size: 15px; color: #{text_col};" t-field="doc.company_id.name"/>
                            <t t-if="doc.picking_type_id and doc.picking_type_id.warehouse_id and doc.picking_type_id.warehouse_id.partner_id">
                                <t t-set="wh_partner" t-value="doc.picking_type_id.warehouse_id.partner_id"/>
                                <div t-if="wh_partner.street" t-field="wh_partner.street"/>
                                <div t-if="wh_partner.street2" t-field="wh_partner.street2"/>
                                <div>
                                    <span t-if="wh_partner.city" t-field="wh_partner.city"/>
                                    <span t-if="wh_partner.state_id">, <span t-field="wh_partner.state_id.name"/></span>
                                    <span t-if="wh_partner.zip"> - <span t-field="wh_partner.zip"/></span>
                                </div>
                                <div t-if="wh_partner.country_id" t-field="wh_partner.country_id.name"/>
                            </t>
                            <t t-else="">
                                <div t-if="doc.company_id.street" t-field="doc.company_id.street"/>
                                <div t-if="doc.company_id.street2" t-field="doc.company_id.street2"/>
                                <div>
                                    <span t-if="doc.company_id.city" t-field="doc.company_id.city"/>
                                    <span t-if="doc.company_id.state_id">, <span t-field="doc.company_id.state_id.name"/></span>
                                    <span t-if="doc.company_id.zip"> - <span t-field="doc.company_id.zip"/></span>
                                </div>
                                <div t-if="doc.company_id.country_id" t-field="doc.company_id.country_id.name"/>
                            </t>
                        </div>
                    </div>

                    <!-- Right: To Address (Delivery) -->
                    <div class="col-6">
                        <div t-attf-style="font-weight: 900; font-size: 15.5px; margin-bottom: 3px; color: #{text_col};">To Address :</div>
                        <div style="padding-left: 8px;">
                            <div t-if="doc.partner_id" t-field="doc.partner_id.name" t-attf-style="font-weight: bold; text-transform: uppercase; font-size: 15px; color: #{text_col};"/>
                            <div t-if="doc.partner_id and doc.partner_id.street">
                                <span class="fa fa-map-marker me-1" style="color: #444;"/>
                                <span t-field="doc.partner_id.street"/>
                            </div>
                            <div t-if="doc.partner_id and doc.partner_id.street2" t-field="doc.partner_id.street2"/>
                            <div t-if="doc.partner_id">
                                <span t-if="doc.partner_id.city" t-field="doc.partner_id.city"/>
                                <span t-if="doc.partner_id.state_id">, <span t-field="doc.partner_id.state_id.name"/></span>
                                <span t-if="doc.partner_id.zip"> - <span t-field="doc.partner_id.zip"/></span>
                            </div>
                            <div t-if="doc.partner_id and doc.partner_id.country_id" t-field="doc.partner_id.country_id.name"/>
                            <div t-if="doc.partner_id and doc.partner_id.phone" class="mt-1">
                                <strong style="font-weight: 900;">Phone: </strong><span t-field="doc.partner_id.phone"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Key Meta Info Grid (Splitted equally left and right) -->
                <div class="row mb-3" style="font-size: 14px;">
                    <!-- Left Side Meta Info -->
                    <div class="col-6">
                        <table class="table table-sm table-borderless" style="font-size: 14px; margin-bottom: 0;">
                            <tbody>
                                <tr t-if="doc.origin">
                                    <td t-attf-style="font-weight: 900; width: 45%; padding: 3px 0; color: #{text_col};">Order</td>
                                    <td t-attf-style="width: 55%; padding: 3px 0; color: #{text_col};"><span t-field="doc.origin"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Right Side Meta Info -->
                    <div class="col-6">
                        <table class="table table-sm table-borderless" style="font-size: 14px; margin-bottom: 0;">
                            <tbody>
                                <tr t-if="doc.date_done or doc.scheduled_date">
                                    <td t-attf-style="font-weight: 900; width: 45%; padding: 3px 0; color: #{text_col};">Shipping Date</td>
                                    <td t-attf-style="width: 55%; padding: 3px 0; color: #{text_col};">
                                        <span t-if="doc.date_done" t-field="doc.date_done" t-options='{"widget": "date", "format": "MM/dd/yyyy"}'/>
                                        <span t-elif="doc.scheduled_date" t-field="doc.scheduled_date" t-options='{"widget": "date", "format": "MM/dd/yyyy"}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 4. Line Items Table -->
                <table class="table table-sm o_main_table" style="width: 100%; border-collapse: collapse; font-size: 13.5px; margin-top: 12px; margin-bottom: 16px; border: 1.5px solid #555555;">
                    <thead style="display: table-row-group;">
                        <tr t-attf-style="background-color: #{table_col}; color: #{text_col}; font-weight: 900; text-align: center; text-transform: uppercase; font-size: 14px; page-break-inside: avoid;">
                            <th style="padding: 7px 6px; border: 1.5px solid #555555; width: 8%; font-weight: 900;">S/No</th>
                            <th style="padding: 7px 6px; border: 1.5px solid #555555; text-align: left; width: 52%; font-weight: 900;">Product</th>
                            <th style="padding: 7px 6px; border: 1.5px solid #555555; text-align: right; width: 20%; font-weight: 900;">Ordered</th>
                            <th style="padding: 7px 6px; border: 1.5px solid #555555; text-align: right; width: 20%; font-weight: 900;">Delivered</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="line_no" t-value="1"/>
                        <t t-if="'move_ids_without_package' in doc._fields and doc.move_ids_without_package">
                            <t t-set="moves" t-value="doc.move_ids_without_package"/>
                        </t>
                        <t t-elif="'move_ids' in doc._fields and doc.move_ids">
                            <t t-set="moves" t-value="doc.move_ids"/>
                        </t>
                        <t t-else="">
                            <t t-set="moves" t-value="doc.move_line_ids"/>
                        </t>
                        <t t-foreach="moves" t-as="move">
                            <tr style="border-bottom: 1.5px solid #555555; vertical-align: top; page-break-inside: avoid;">
                                <td style="padding: 7px 6px; text-align: center; border: 1.5px solid #555555;">
                                    <span t-esc="line_no"/>
                                    <t t-set="line_no" t-value="line_no + 1"/>
                                </td>
                                <td style="padding: 7px 6px; border: 1.5px solid #555555; vertical-align: top;">
                                    <span t-if="'description_picking' in move._fields and move.description_picking and move.description_picking != move.product_id.name" t-field="move.description_picking"/>
                                    <span t-else="" t-field="move.product_id.display_name"/>
                                </td>
                                <td style="padding: 7px 6px; text-align: right; border: 1.5px solid #555555;">
                                    <span t-if="'product_uom_qty' in move._fields" t-field="move.product_uom_qty"/>
                                    <span t-elif="'quantity' in move._fields" t-field="move.quantity"/>
                                    <span class="ms-1" t-if="'product_uom' in move._fields and move.product_uom" t-field="move.product_uom.name"/>
                                    <span class="ms-1" t-elif="'product_uom_id' in move._fields and move.product_uom_id" t-field="move.product_uom_id.name"/>
                                </td>
                                <td style="padding: 7px 6px; text-align: right; border: 1.5px solid #555555;">
                                    <span t-if="'quantity_done' in move._fields" t-field="move.quantity_done"/>
                                    <span t-elif="'quantity' in move._fields" t-field="move.quantity"/>
                                    <span class="ms-1" t-if="'product_uom' in move._fields and move.product_uom" t-field="move.product_uom.name"/>
                                    <span class="ms-1" t-elif="'product_uom_id' in move._fields and move.product_uom_id" t-field="move.product_uom_id.name"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- 5. Note Section -->
                <t t-if="'note' in doc._fields and doc.note">
                    <div class="mb-3" t-attf-style="font-size: 13px; page-break-inside: avoid; color: #{text_col};">
                        <strong style="font-weight: 900;">Note:</strong>
                        <p t-field="doc.note" class="mt-1" style="white-space: pre-line;"/>
                    </div>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
