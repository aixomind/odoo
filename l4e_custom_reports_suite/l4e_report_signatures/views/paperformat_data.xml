<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Custom A4 paper format with enlarged bottom margin for signature block.
             Select this manually in Settings > Technical > Reporting > Paper Formats
             and assign it to your report actions on the live server. -->
        <record id="paperformat_l4e_a4_signature" model="report.paperformat">
            <field name="name">A4 - L4E Signature Layout</field>
            <field name="default">False</field>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">42.00</field>
            <field name="margin_bottom">45.00</field>
            <field name="margin_left">5.00</field>
            <field name="margin_right">5.00</field>
            <field name="header_line">False</field>
            <field name="header_spacing">35</field>
            <field name="disable_shrinking">False</field>
            <field name="dpi">90</field>
        </record>
    </data>
</odoo>
