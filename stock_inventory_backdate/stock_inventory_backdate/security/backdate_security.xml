<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Odoo 19 security model: groups no longer carry category_id directly.
         They reference a res.groups.privilege record via privilege_id. -->
    <record id="module_category_inventory_backdate" model="ir.module.category">
        <field name="name">Inventory Date Correction</field>
        <field name="description">Who may rewrite the date of a validated inventory adjustment.</field>
        <field name="sequence">40</field>
    </record>

    <record id="privilege_inventory_backdate" model="res.groups.privilege">
        <field name="name">Backdate Inventory Adjustments</field>
        <field name="category_id" ref="module_category_inventory_backdate"/>
    </record>

    <record id="group_inventory_backdate" model="res.groups">
        <field name="name">Backdate Inventory Adjustments</field>
        <field name="privilege_id" ref="privilege_inventory_backdate"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="comment">Allows moving a validated inventory adjustment - and its stock moves
            and journal entries - to another date.</field>
    </record>

    <!-- The administrator gets it out of the box; everyone else is assigned explicitly. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_inventory_backdate'))]"/>
    </record>

</odoo>
