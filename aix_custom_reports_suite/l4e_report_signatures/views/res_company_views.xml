<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Res Company Form View Extension for Company Stamp & Seal -->
    <record id="view_company_form_inherit_l4e_stamp" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l4e.stamp</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Company Stamp &amp; Seal" name="company_stamp_page">
                    <group>
                        <group string="Company Stamp Configuration">
                            <field name="enable_company_stamp" widget="boolean_toggle"/>
                            <field name="company_stamp_image" widget="signature"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
