<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_l4e_discount" model="ir.ui.view">
        <field name="name">res.config.settings.view.l4e.discount</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='pricing_setting_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="l4e_discount_approval">
                    <div class="o_setting_left_pane">
                        <field name="l4e_discount_approval_required"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="l4e_discount_approval_required" string="Require Discount Approval"/>
                        <div class="text-muted">
                            When enabled, discounts exceeding a salesperson's limit require manager approval before the order can be confirmed.
                        </div>
                        <div class="content-group" attrs="{'invisible': [('l4e_discount_approval_required', '=', False)]}">
                            <div class="mt8 row">
                                <label for="l4e_default_global_limit" class="col-lg-5 o_light_label" string="Default Global Limit (%)"/>
                                <field name="l4e_default_global_limit" class="col-lg-3"/>
                            </div>
                            <div class="mt4 row">
                                <label for="l4e_default_line_limit" class="col-lg-5 o_light_label" string="Default Per-Line Limit (%)"/>
                                <field name="l4e_default_line_limit" class="col-lg-3"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
