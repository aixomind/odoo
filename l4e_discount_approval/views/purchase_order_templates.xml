<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Inherited Template for purchase order report-->
    <template id="report_purchaseorder_document_customized"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-call='account.document_tax_totals']" position="replace">
            <t t-call="account.document_tax_totals">
                <t t-set="tax_totals" t-value="o.tax_totals"/>
                <t t-set="currency" t-value="o.currency_id"/>
                <t t-set="amt_discount" t-value="o.amount_discount"/>
            </t>
        </xpath>
    </template>
</odoo>
