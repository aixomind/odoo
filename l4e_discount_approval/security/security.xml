<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_discount_salesperson" model="res.groups">
        <field name="name">Discount Salesperson</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_discount_manager" model="res.groups">
        <field name="name">Discount Manager</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[
            (4, ref('l4e_discount_approval.group_discount_salesperson')),
            (4, ref('sales_team.group_sale_manager'))
        ]"/>
    </record>

    <data noupdate="1">
        <record id="rule_discount_limit_own" model="ir.rule">
            <field name="name">Discount Limit: salesperson sees own</field>
            <field name="model_id" ref="model_l4e_discount_limit"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
        <record id="rule_discount_limit_all" model="ir.rule">
            <field name="name">Discount Limit: manager sees all</field>
            <field name="model_id" ref="model_l4e_discount_limit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('l4e_discount_approval.group_discount_manager'))]"/>
        </record>
    </data>
</odoo>
