<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited view form of purchase order -->
    <record id="view_purchase_order_form_discount" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.sale.discount.total</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Discount fields above the notes/terms area -->
            <xpath expr="//field[@name='notes']" position="before">
                <group name="po_discount_group">
                    <field name="discount_type"/>
                    <field name="discount_rate" class="oe_inline"
                           invisible="discount_type == 'line'"/>
                    <field name="line_auto_discount"
                           invisible="discount_type != 'line'"/>
                    <field name="line_discount_apply_type"
                           invisible="discount_type != 'line' or not line_auto_discount"/>
                    <field name="line_discount_apply_value"
                           invisible="discount_type != 'line' or not line_auto_discount"/>
                </group>
            </xpath>

            <xpath expr="//field[@name='tax_totals']" position="replace">
                <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}"/>
                <field name="amount_discount" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}"/>
                <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}"/>
                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                    <label for="amount_total"/>
                    <button name="button_dummy" invisible="state not in ['draft','sent']" string="(update)" type="object" class="oe_edit_only oe_link"/>
                </div>
                <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>

            <!-- Disc % column: hide when not line-wise, readonly on auto -->
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="attributes">
                <attribute name="digits">[16, 2]</attribute>
                <attribute name="column_invisible">parent.discount_type != 'line'</attribute>
                <attribute name="readonly">parent.line_auto_discount</attribute>
            </xpath>
            <!-- Add Disc Value column after Disc % -->
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="after">
                <field name="discount_value"
                       widget="monetary"
                       options="{'currency_field': 'currency_id', 'no_symbol': True}"
                       optional="show"
                       column_invisible="parent.discount_type != 'line'"
                       readonly="parent.line_auto_discount"/>
            </xpath>
            <!-- Actual Amount (before discount) after Subtotal -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="after">
                <field name="l4e_actual_amount"
                       widget="monetary"
                       options="{'currency_field': 'currency_id', 'no_symbol': True}"
                       string="Actual Amount"
                       readonly="1"/>
<!--                       invisible="discount == 0"/>-->
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="options">{'currency_field': 'currency_id', 'no_symbol': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="attributes">
                <attribute name="options">{'currency_field': 'currency_id', 'no_symbol': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
