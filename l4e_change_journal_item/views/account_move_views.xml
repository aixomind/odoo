<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_change_journal" model="ir.ui.view">
        <field name="name">account.move.form.inherit.change.journal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="after">
                <button name="action_change_journal_items"
                        string="Change Journal Items"
                        type="object"
                        class="btn-secondary"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>
