<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="l4e_dashboard_collection.SaleDashboardAction" owl="1">
<div class="o_sdash_page">

    <div class="o_sdash_toolbar">
        <div class="o_sdash_title_wrap">
            <div class="o_sdash_hero_icon"><i class="fa fa-line-chart"/></div>
            <div>
                <h1>Sales Dashboard</h1>
                <p>Overview of your sales pipeline and invoice status.</p>
            </div>
        </div>

        <div class="o_sdash_filters">
            <select class="o_sdash_filter" t-att-value="state.filterYear || ''" t-on-change="onYearChange">
                <option value="">All Years</option>
                <t t-foreach="availableYears" t-as="yr" t-key="yr">
                    <option t-att-value="yr"><t t-out="yr"/></option>
                </t>
            </select>

            <select class="o_sdash_filter" t-att-value="state.teamId" t-on-change="onTeamChange">
                <option value="">All Sales Teams</option>
                <t t-foreach="state.teams" t-as="team" t-key="team.id">
                    <option t-att-value="team.id"><t t-out="team.name"/></option>
                </t>
            </select>

            <select class="o_sdash_filter" t-att-value="state.userId" t-on-change="onUserChange">
                <option value="">All Salespeople</option>
                <t t-foreach="state.users" t-as="user" t-key="user.id">
                    <option t-att-value="user.id"><t t-out="user.name"/></option>
                </t>
            </select>

            <div class="o_sdash_daterange">
                <span class="o_sdash_dr_sep">~</span>
                <input type="date" class="o_sdash_date_input" t-att-value="state.fromDate" t-att-max="state.toDate" t-on-change="onFromDateChange"/>
                <span class="o_sdash_dr_sep">-</span>
                <input type="date" class="o_sdash_date_input" t-att-value="state.toDate" t-att-min="state.fromDate" t-on-change="onToDateChange"/>
                <i class="fa fa-calendar o_sdash_dr_icon"/>
            </div>

            <button class="o_sdash_reset_btn" t-on-click="resetFilters">
                <i class="fa fa-refresh"/> Reset
            </button>
        </div>
    </div>

    <div class="o_sdash_content">
        <div class="o_sdash_section_head">
            <span class="o_sdash_section_dot"/>
            Sale Orders
        </div>

        <t t-if="state.loading">
            <div class="o_sdash_loading">
                <i class="fa fa-spinner fa-spin me-2"/>Loading stats...
            </div>
        </t>

        <t t-else="">
            <div class="o_sdash_order_grid">
                <t t-foreach="primaryCards" t-as="card" t-key="card.key">
                    <button t-att-class="getCardClass(card)" t-on-click="() => this.onCardClick(card.key)">
                        <div class="o_sdash_card_head">
                            <span class="o_sdash_card_icon">
                                <i t-attf-class="fa {{ card.icon }}"/>
                            </span>
                            <span class="o_sdash_card_label" t-out="card.label"/>
                        </div>
                        <div class="o_sdash_card_count" t-out="card.count"/>
                        <div class="o_sdash_card_unit">Orders</div>
                        <div class="o_sdash_card_amount" t-out="card.amount_formatted"/>
                        <div class="o_sdash_card_sub" t-out="card.sub_label"/>
                        <span class="o_sdash_card_arrow"><i class="fa fa-arrow-right"/></span>
                    </button>
                </t>
            </div>

            <div class="o_sdash_summary_band">
                <t t-foreach="summaryMetrics" t-as="metric" t-key="metric.key">
                    <button class="o_sdash_summary_item" t-on-click="() => this.openSummaryMetric(metric.key)">
                        <span t-att-class="'o_sdash_summary_icon tone-' + metric.tone">
                            <i t-attf-class="fa {{ metric.icon }}"/>
                        </span>
                        <div>
                            <div class="o_sdash_summary_label" t-out="metric.label"/>
                            <div class="o_sdash_summary_value" t-out="metric.value"/>
                            <t t-if="metric.sub">
                                <div class="o_sdash_summary_sub" t-out="metric.sub"/>
                            </t>
                            <t t-else="">
                                <div class="o_sdash_summary_trend">
                                    <i class="fa fa-arrow-up"/> <t t-out="metric.trend"/> <span>vs last period</span>
                                </div>
                            </t>
                        </div>
                    </button>
                </t>
            </div>

            <div class="o_sdash_bottom_grid">
                <section class="o_sdash_panel o_sdash_chart_panel">
                    <div class="o_sdash_panel_header">
                        <h2>Sales Overview</h2>
                        <span class="o_sdash_period_badge" t-out="activeBadgeLabel"/>
                    </div>
                    <div class="o_sdash_svg_chart">
                        <svg viewBox="0 0 760 260" preserveAspectRatio="none">
                            <defs>
                                <linearGradient id="o_sdash_chart_fill" x1="0" x2="0" y1="0" y2="1">
                                    <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.24"/>
                                    <stop offset="100%" stop-color="#7c3aed" stop-opacity="0.02"/>
                                </linearGradient>
                            </defs>
                            <t t-foreach="chartYTicks" t-as="tick" t-key="tick.y">
                                <line x1="58" x2="742" t-att-y1="tick.y" t-att-y2="tick.y" class="o_sdash_grid_line"/>
                                <text x="14" t-att-y="tick.y + 4" class="o_sdash_axis_label" t-out="tick.label"/>
                            </t>
                            <path t-att-d="chartAreaPath" class="o_sdash_area_path"/>
                            <polyline t-att-points="chartPolyline" class="o_sdash_line_path"/>
                            <t t-foreach="chartPoints" t-as="point" t-key="point.label">
                                <g class="o_sdash_chart_hit" t-on-click="() => this.openMonthlyPoint(point)">
                                    <rect t-att-x="point.x - 18" y="18" width="36" height="218"/>
                                    <circle t-att-cx="point.x" t-att-cy="point.y" r="4" class="o_sdash_line_point"/>
                                    <text t-att-x="point.x" y="250" text-anchor="middle" class="o_sdash_x_label" t-out="point.short_label"/>
                                </g>
                            </t>
                        </svg>
                    </div>
                </section>

                <section class="o_sdash_panel">
                    <div class="o_sdash_panel_header">
                        <h2>Recent Activities</h2>
                    </div>
                    <div class="o_sdash_activity_list">
                        <t t-if="!state.recentActivities.length">
                            <div class="o_sdash_empty">No recent sales activity.</div>
                        </t>
                        <t t-foreach="state.recentActivities" t-as="activity" t-key="activity.title">
                            <button class="o_sdash_activity_item" t-on-click="() => this.openRecentActivity(activity)">
                                <span t-att-class="getActivityClass(activity)">
                                    <i t-attf-class="fa {{ activity.icon }}"/>
                                </span>
                                <div class="o_sdash_activity_text">
                                    <strong t-out="activity.title"/>
                                    <span>Customer: <t t-out="activity.customer"/></span>
                                </div>
                                <time t-out="activity.time_label"/>
                            </button>
                        </t>
                    </div>
                </section>
            </div>
        </t>
    </div>

</div>
</t>

</templates>
