<templates xml:space="preserve">
  <t t-name="l4e_dashboard_collection.crm_dashboard" owl="1">
    <div class="l4e-dashboard-container">
      
      <!-- Top Filter Bar Aligned in Single Clean Line (GLOBAL FILTERS) -->
      <div class="l4e-topbar-row">
        <div class="l4e-topbar-left">
          <h2 class="l4e-topbar-title">CRM Dashboard</h2>
          <span class="l4e-topbar-subtitle">Overview of your sales performance and activities.</span>
        </div>

        <div class="l4e-filter-controls">
          <!-- Custom Year Dropdown -->
          <div class="l4e-dropdown-container" t-on-click-outside="() => this.closeDropdown('year')">
            <button class="l4e-dropdown-trigger" t-on-click="() => this.toggleDropdown('year')">
              <span t-esc="state.filters.year_filter || '2026'"/>
              <i class="fa fa-chevron-down"/>
            </button>
            <div class="l4e-dropdown-menu" t-if="state.dropdowns.year">
              <t t-foreach="state.data.years || []" t-as="y" t-key="y">
                <div class="l4e-dropdown-item" t-on-click="() => this.selectFilter('year_filter', y)"><t t-esc="y"/></div>
              </t>
            </div>
          </div>


          <!-- Custom Team Dropdown -->
          <div class="l4e-dropdown-container" t-on-click-outside="() => this.closeDropdown('team')">
            <button class="l4e-dropdown-trigger" t-on-click="() => this.toggleDropdown('team')">
              <span t-esc="state.data.teams &amp;&amp; state.data.teams.find(t => t.id == state.filters.team_id) ? state.data.teams.find(t => t.id == state.filters.team_id).name : 'All Sales Teams'"/>
              <i class="fa fa-chevron-down"/>
            </button>
            <div class="l4e-dropdown-menu" t-if="state.dropdowns.team">
              <div class="l4e-dropdown-item" t-on-click="() => this.selectFilter('team_id', '')">All Sales Teams</div>
              <t t-foreach="state.data.teams || []" t-as="x" t-key="x.id">
                <div class="l4e-dropdown-item" t-on-click="() => this.selectFilter('team_id', x.id.toString())"><t t-esc="x.name"/></div>
              </t>
            </div>
          </div>

          <!-- Custom Salesperson Dropdown -->
          <div class="l4e-dropdown-container" t-on-click-outside="() => this.closeDropdown('user')">
            <button class="l4e-dropdown-trigger" t-on-click="() => this.toggleDropdown('user')">
              <span t-esc="state.data.users &amp;&amp; state.data.users.find(u => u.id == state.filters.user_id) ? state.data.users.find(u => u.id == state.filters.user_id).name : 'All Salespeople'"/>
              <i class="fa fa-chevron-down"/>
            </button>
            <div class="l4e-dropdown-menu" t-if="state.dropdowns.user">
              <div class="l4e-dropdown-item" t-on-click="() => this.selectFilter('user_id', '')">All Salespeople</div>
              <t t-foreach="state.data.users || []" t-as="x" t-key="x.id">
                <div class="l4e-dropdown-item" t-on-click="() => this.selectFilter('user_id', x.id.toString())"><t t-esc="x.name"/></div>
              </t>
            </div>
          </div>

          <div class="l4e-input-group date-picker-group">
            <input name="date_from" type="date" t-att-value="state.filters.date_from || ''" t-on-change="setFilter" title="Start Date"/>
            <span>-</span>
            <input name="date_to" type="date" t-att-value="state.filters.date_to || ''" t-on-change="setFilter" title="End Date"/>
          </div>

          <button class="l4e-btn-refresh" t-on-click="resetFilters" title="Reset Dashboard"><i class="fa fa-undo"/> Reset</button>
        </div>
      </div>

      <!-- KPI Summary Card (all 6 metrics in one container) -->
      <div class="l4e-card l4e-kpi-container">
        <div class="card-header">
          <div class="card-header-actions">
            <select class="mini-select" t-on-change="(e) => this.setKpiMonthAll(e.target.value)">
              <option value="1"   t-att-selected="state.card_filters.kpi_total == '1'">January</option>
              <option value="2"   t-att-selected="state.card_filters.kpi_total == '2'">February</option>
              <option value="3"   t-att-selected="state.card_filters.kpi_total == '3'">March</option>
              <option value="4"   t-att-selected="state.card_filters.kpi_total == '4'">April</option>
              <option value="5"   t-att-selected="state.card_filters.kpi_total == '5'">May</option>
              <option value="6"   t-att-selected="state.card_filters.kpi_total == '6'">June</option>
              <option value="7"   t-att-selected="state.card_filters.kpi_total == '7'">July</option>
              <option value="8"   t-att-selected="state.card_filters.kpi_total == '8'">August</option>
              <option value="9"   t-att-selected="state.card_filters.kpi_total == '9'">September</option>
              <option value="10"  t-att-selected="state.card_filters.kpi_total == '10'">October</option>
              <option value="11"  t-att-selected="state.card_filters.kpi_total == '11'">November</option>
              <option value="12"  t-att-selected="state.card_filters.kpi_total == '12'">December</option>
              <option value="all" t-att-selected="state.card_filters.kpi_total == 'all'">All Time</option>
            </select>
          </div>
        </div>

        <div class="card-body">
          <div class="l4e-kpi-grid">

            <!-- Total Leads -->
            <div class="l4e-kpi-card" t-on-click="()=>this.openKpi('total')">
              <div class="kpi-icon-wrap icon-purple">
                <i class="fa fa-users"/>
              </div>
              <div class="kpi-content">
                <span class="kpi-label">Total Leads</span>
                <h3 class="kpi-value"><t t-esc="state.data.kpis ? state.data.kpis.total_leads_formatted : '0'"/></h3>
              </div>
            </div>

            <!-- Won Revenue -->
            <div class="l4e-kpi-card" t-on-click="()=>this.openKpi('won')">
              <div class="kpi-icon-wrap icon-green">
                <i class="fa fa-trophy"/>
              </div>
              <div class="kpi-content">
                <span class="kpi-label">Won Revenue</span>
                <h3 class="kpi-value"><t t-esc="state.data.kpis ? state.data.kpis.won_revenue_formatted : '$0'"/></h3>
              </div>
            </div>

            <!-- Lost Revenue -->
            <div class="l4e-kpi-card" t-on-click="()=>this.openKpi('lost')">
              <div class="kpi-icon-wrap icon-red">
                <i class="fa fa-times"/>
              </div>
              <div class="kpi-content">
                <span class="kpi-label">Lost Revenue</span>
                <h3 class="kpi-value"><t t-esc="state.data.kpis ? state.data.kpis.lost_revenue_formatted : '$0'"/></h3>
              </div>
            </div>

            <!-- Quotation Pending -->
            <div class="l4e-kpi-card" t-on-click="()=>this.openKpi('quotes')">
              <div class="kpi-icon-wrap icon-orange">
                <i class="fa fa-file-text-o"/>
              </div>
              <div class="kpi-content">
                <span class="kpi-label">Quotation Pending</span>
                <h3 class="kpi-value"><t t-esc="state.data.kpis ? state.data.kpis.quotes_pending_formatted : '0'"/></h3>
              </div>
            </div>

            <!-- Overdue Activities -->
            <div class="l4e-kpi-card" t-on-click="()=>this.openKpi('overdue')">
              <div class="kpi-icon-wrap icon-darkred">
                <i class="fa fa-clock-o"/>
              </div>
              <div class="kpi-content">
                <span class="kpi-label">Overdue Activities</span>
                <h3 class="kpi-value"><t t-esc="state.data.kpis ? state.data.kpis.overdue_activities_formatted : '0'"/></h3>
              </div>
            </div>

            <!-- Activities Due Today -->
            <div class="l4e-kpi-card" t-on-click="()=>this.openKpi('today')">
              <div class="kpi-icon-wrap icon-blue">
                <i class="fa fa-calendar-check-o"/>
              </div>
              <div class="kpi-content">
                <span class="kpi-label">Activities Due Today</span>
                <h3 class="kpi-value"><t t-esc="state.data.kpis ? state.data.kpis.today_activities_formatted : '0'"/></h3>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Row 1: Month Sales Trend & Pipeline Details -->
      <div class="l4e-row">
        
        <!-- Month Sales Trend Chart Card (CARD SPECIFIC FILTER) -->
        <div class="l4e-card col-half">
          <div class="card-header">
            <h4>Month Sales Trend</h4>
            <div class="card-header-actions">
              <select class="mini-select" t-att-value="state.card_filters.sales_trend" t-on-change="(e) => this.setCardFilter('sales_trend', e)">
                <option value="1" t-att-selected="(state.card_filters.sales_trend || state.filters.month_filter) == '1'">January</option>
                <option value="2" t-att-selected="(state.card_filters.sales_trend || state.filters.month_filter) == '2'">February</option>
                <option value="3" t-att-selected="(state.card_filters.sales_trend || state.filters.month_filter) == '3'">March</option>
                <option value="4" t-att-selected="(state.card_filters.sales_trend || state.filters.month_filter) == '4'">April</option>
                <option value="5" t-att-selected="(state.card_filters.sales_trend || state.filters.month_filter) == '5'">May</option>
                <option value="6" t-att-selected="(state.card_filters.sales_trend || state.filters.month_filter) == '6'">June</option>
                <option value="7" t-att-selected="(state.card_filters.sales_trend || state.filters.month_filter) == '7'">July</option>
                <option value="8" t-att-selected="(state.card_filters.sales_trend || state.filters.month_filter) == '8'">August</option>
                <option value="9" t-att-selected="(state.card_filters.sales_trend || state.filters.month_filter) == '9'">September</option>
                <option value="10" t-att-selected="(state.card_filters.sales_trend || state.filters.month_filter) == '10'">October</option>
                <option value="11" t-att-selected="(state.card_filters.sales_trend || state.filters.month_filter) == '11'">November</option>
                <option value="12" t-att-selected="(state.card_filters.sales_trend || state.filters.month_filter) == '12'">December</option>
                <option value="all" t-att-selected="(state.card_filters.sales_trend || state.filters.month_filter) == 'all'">All Time</option>
              </select>
            </div>
          </div>
          
          <div class="card-body chart-body">
            <div class="chart-legend-badge">
              <span class="dot-purple"/> Revenue (<t t-esc="state.data.currency ? state.data.currency.name : 'USD'"/>)
            </div>

            <div class="area-chart-container">
              <svg viewBox="0 0 500 180" preserveAspectRatio="none" class="area-chart-svg">
                <defs>
                  <linearGradient id="purpleGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.35"/>
                    <stop offset="100%" stop-color="#7c3aed" stop-opacity="0.0"/>
                  </linearGradient>
                </defs>
                <t t-if="state.data.month_sales_trend">
                  <path t-att-d="state.data.month_sales_trend.area_path" fill="url(#purpleGradient)"/>
                  <path t-att-d="state.data.month_sales_trend.line_path" fill="none" stroke="#7c3aed" stroke-width="3"/>
                  <t t-foreach="state.data.month_sales_trend.points" t-as="pt" t-key="pt.label">
                    <circle t-att-cx="pt.x" t-att-cy="pt.y" r="6" fill="#7c3aed" stroke="var(--l4e-card-bg, #ffffff)" stroke-width="2" t-on-click="() => this.openSalesTrendPoint(pt)" style="cursor: pointer;"/>
                    <text t-att-x="pt.x" t-att-y="pt.y - 10" text-anchor="middle" font-size="10" font-weight="600" fill="var(--l4e-chart-text, #475569)" t-on-click="() => this.openSalesTrendPoint(pt)" style="cursor: pointer;"><t t-esc="pt.revenue_formatted"/></text>
                  </t>
                </t>
              </svg>
              <div class="chart-x-axis">
                <t t-if="state.data.month_sales_trend">
                  <t t-foreach="state.data.month_sales_trend.points" t-as="pt" t-key="pt.label">
                    <span><t t-esc="pt.label"/></span>
                  </t>
                </t>
              </div>
            </div>
          </div>
        </div>

        <!-- Pipeline Details Table Card (CARD SPECIFIC FILTER) -->
        <div class="l4e-card col-half">
          <div class="card-header">
            <h4>Pipeline Details</h4>
            <div class="card-header-actions">
              <select class="mini-select" t-att-value="state.card_filters.pipeline" t-on-change="(e) => this.setCardFilter('pipeline', e)">
                <option value="1" t-att-selected="(state.card_filters.pipeline || state.filters.month_filter) == '1'">January</option>
                <option value="2" t-att-selected="(state.card_filters.pipeline || state.filters.month_filter) == '2'">February</option>
                <option value="3" t-att-selected="(state.card_filters.pipeline || state.filters.month_filter) == '3'">March</option>
                <option value="4" t-att-selected="(state.card_filters.pipeline || state.filters.month_filter) == '4'">April</option>
                <option value="5" t-att-selected="(state.card_filters.pipeline || state.filters.month_filter) == '5'">May</option>
                <option value="6" t-att-selected="(state.card_filters.pipeline || state.filters.month_filter) == '6'">June</option>
                <option value="7" t-att-selected="(state.card_filters.pipeline || state.filters.month_filter) == '7'">July</option>
                <option value="8" t-att-selected="(state.card_filters.pipeline || state.filters.month_filter) == '8'">August</option>
                <option value="9" t-att-selected="(state.card_filters.pipeline || state.filters.month_filter) == '9'">September</option>
                <option value="10" t-att-selected="(state.card_filters.pipeline || state.filters.month_filter) == '10'">October</option>
                <option value="11" t-att-selected="(state.card_filters.pipeline || state.filters.month_filter) == '11'">November</option>
                <option value="12" t-att-selected="(state.card_filters.pipeline || state.filters.month_filter) == '12'">December</option>
                <option value="all" t-att-selected="(state.card_filters.pipeline || state.filters.month_filter) == 'all'">All Time</option>
              </select>
            </div>
          </div>

          <div class="card-body table-body">
            <table class="l4e-table">
              <thead>
                <tr>
                  <th>Stage</th>
                  <th class="text-center">Opportunities</th>
                  <th class="text-end">Expected Revenue (<t t-esc="state.data.currency ? state.data.currency.name : 'USD'"/>)</th>
                </tr>
              </thead>
              <tbody>
                <t t-if="state.data.pipeline_details">
                  <t t-foreach="state.data.pipeline_details.rows || []" t-as="row" t-key="row.name">
                    <tr t-on-click="() => this.openPipelineStage(row)" style="cursor: pointer;">
                      <td>
                        <span class="stage-dot" t-attf-style="background-color: #{row.color};"/>
                        <b class="stage-name"><t t-esc="row.name"/></b>
                      </td>
                      <td class="text-center"><t t-esc="row.count"/></td>
                      <td class="text-end fw-bold"><t t-esc="row.expected_revenue"/></td>
                    </tr>
                  </t>
                </t>
              </tbody>
              <tfoot>
                <tr class="table-total-row">
                  <th>Total</th>
                  <th class="text-center"><t t-esc="state.data.pipeline_details ? state.data.pipeline_details.total_count : '0'"/></th>
                  <th class="text-end fw-bold"><t t-esc="state.data.pipeline_details ? state.data.pipeline_details.total_expected_revenue : '$0'"/></th>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>

      </div>

      <!-- Row 2: Sales Team Performance & Recent Won Orders -->
      <div class="l4e-row">

        <!-- Sales Team Performance Horizontal Bar Chart (CARD SPECIFIC FILTER) -->
        <div class="l4e-card col-half">
          <div class="card-header">
            <h4>Sales Team Performance</h4>
            <div class="card-header-actions">
              <select class="mini-select" t-att-value="state.card_filters.team_perf" t-on-change="(e) => this.setCardFilter('team_perf', e)">
                <option value="1" t-att-selected="(state.card_filters.team_perf || state.filters.month_filter) == '1'">January</option>
                <option value="2" t-att-selected="(state.card_filters.team_perf || state.filters.month_filter) == '2'">February</option>
                <option value="3" t-att-selected="(state.card_filters.team_perf || state.filters.month_filter) == '3'">March</option>
                <option value="4" t-att-selected="(state.card_filters.team_perf || state.filters.month_filter) == '4'">April</option>
                <option value="5" t-att-selected="(state.card_filters.team_perf || state.filters.month_filter) == '5'">May</option>
                <option value="6" t-att-selected="(state.card_filters.team_perf || state.filters.month_filter) == '6'">June</option>
                <option value="7" t-att-selected="(state.card_filters.team_perf || state.filters.month_filter) == '7'">July</option>
                <option value="8" t-att-selected="(state.card_filters.team_perf || state.filters.month_filter) == '8'">August</option>
                <option value="9" t-att-selected="(state.card_filters.team_perf || state.filters.month_filter) == '9'">September</option>
                <option value="10" t-att-selected="(state.card_filters.team_perf || state.filters.month_filter) == '10'">October</option>
                <option value="11" t-att-selected="(state.card_filters.team_perf || state.filters.month_filter) == '11'">November</option>
                <option value="12" t-att-selected="(state.card_filters.team_perf || state.filters.month_filter) == '12'">December</option>
                <option value="all" t-att-selected="(state.card_filters.team_perf || state.filters.month_filter) == 'all'">All Time</option>
              </select>
            </div>
          </div>
          <div class="card-body chart-body" style="padding: 16px 20px;">
            <div class="perf-chart-wrap" style="width: 100%; overflow-x: auto;">
              <svg t-att-viewBox="state.data.chart_svg_viewbox || '0 0 500 60'" preserveAspectRatio="xMinYMin meet" style="width: 100%; font-family: inherit;">

                <t t-if="state.data.sales_team_performance and state.data.sales_team_performance.length > 0">
                  <t t-foreach="state.data.sales_team_performance" t-as="user" t-key="user.id">
                    <!-- Salesperson name on the left -->
                    <text
                      t-att-x="user.name_x"
                      t-att-y="user.name_y"
                      text-anchor="end"
                      font-size="11"
                      font-weight="400"
                      fill="var(--l4e-text-primary, #475569)"
                      style="cursor: pointer;"
                      t-on-click="() => this.openSalesPersonDetail(user)"
                    ><t t-esc="user.name_short"/></text>

                    <!-- Horizontal bar -->
                    <rect
                      t-att-x="user.bar_x"
                      t-att-y="user.bar_y"
                      t-att-width="user.bar_w"
                      t-att-height="user.bar_h"
                      t-att-fill="user.color"
                      rx="6"
                      opacity="0.9"
                      t-on-click="() => this.openSalesPersonDetail(user)"
                      style="cursor: pointer; transition: opacity 0.2s;"
                    >
                      <title><t t-esc="user.name"/>: <t t-esc="user.revenue_fmt"/></title>
                    </rect>

                    <!-- Revenue value next to the bar -->
                    <text
                      t-att-x="user.val_x"
                      t-att-y="user.val_y"
                      text-anchor="start"
                      font-size="11"
                      font-weight="600"
                      fill="var(--l4e-text-primary, #1e293b)"
                      t-on-click="() => this.openSalesPersonDetail(user)"
                      style="cursor: pointer;"
                    ><t t-esc="user.revenue_short"/></text>
                  </t>
                </t>

                <!-- Empty state -->
                <t t-if="!state.data.sales_team_performance or state.data.sales_team_performance.length === 0">
                  <text x="450" y="30" text-anchor="middle" font-size="14" font-weight="500" fill="var(--l4e-text-muted, #94a3b8)">No data for this period</text>
                </t>
              </svg>
            </div>

            <!-- Legend placed BELOW the chart centered -->
            <div class="chart-legend-badge" style="justify-content: center; margin-top: 16px; margin-bottom: 0;">
              <span class="dot-purple"/> Revenue (<t t-esc="state.data.currency ? state.data.currency.name : 'USD'"/>)
            </div>

          </div>
        </div>

        <!-- Recent Won Orders Table Card (CARD SPECIFIC FILTER) -->
        <div class="l4e-card col-half">
          <div class="card-header">
            <h4>Recent Won Orders</h4>
            <div class="card-header-actions">
              <select class="mini-select" t-att-value="state.card_filters.recent_won" t-on-change="(e) => this.setCardFilter('recent_won', e)">
                <option value="1" t-att-selected="(state.card_filters.recent_won || state.filters.month_filter) == '1'">January</option>
                <option value="2" t-att-selected="(state.card_filters.recent_won || state.filters.month_filter) == '2'">February</option>
                <option value="3" t-att-selected="(state.card_filters.recent_won || state.filters.month_filter) == '3'">March</option>
                <option value="4" t-att-selected="(state.card_filters.recent_won || state.filters.month_filter) == '4'">April</option>
                <option value="5" t-att-selected="(state.card_filters.recent_won || state.filters.month_filter) == '5'">May</option>
                <option value="6" t-att-selected="(state.card_filters.recent_won || state.filters.month_filter) == '6'">June</option>
                <option value="7" t-att-selected="(state.card_filters.recent_won || state.filters.month_filter) == '7'">July</option>
                <option value="8" t-att-selected="(state.card_filters.recent_won || state.filters.month_filter) == '8'">August</option>
                <option value="9" t-att-selected="(state.card_filters.recent_won || state.filters.month_filter) == '9'">September</option>
                <option value="10" t-att-selected="(state.card_filters.recent_won || state.filters.month_filter) == '10'">October</option>
                <option value="11" t-att-selected="(state.card_filters.recent_won || state.filters.month_filter) == '11'">November</option>
                <option value="12" t-att-selected="(state.card_filters.recent_won || state.filters.month_filter) == '12'">December</option>
                <option value="all" t-att-selected="(state.card_filters.recent_won || state.filters.month_filter) == 'all'">All Time</option>
              </select>
            </div>
          </div>

          <div class="card-body table-body">
            <table class="l4e-table">
              <thead>
                <tr>
                  <th>Order Reference</th>
                  <th>Customer</th>
                  <th>Salesperson</th>
                  <th class="text-end">Revenue (<t t-esc="state.data.currency ? state.data.currency.name : 'USD'"/>)</th>
                  <th>Won Date</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="state.data.recent_won_orders || []" t-as="so" t-key="so.id">
                  <tr t-on-click="()=>this.open('sale.order', [['id','=',so.id]], so.name)">
                    <td class="fw-bold text-primary"><t t-esc="so.name"/></td>
                    <td><t t-esc="so.customer"/></td>
                    <td><t t-esc="so.salesperson"/></td>
                    <td class="text-end fw-bold"><t t-esc="so.revenue"/></td>
                    <td><t t-esc="so.date"/></td>
                  </tr>
                </t>
              </tbody>
            </table>
            <div class="card-footer-link">
              <a href="#" t-on-click.prevent="()=>this.open('sale.order', [['state', 'in', ['sale', 'done']]], 'Won Sales Orders')">View All Won Orders →</a>
            </div>
          </div>
        </div>

      </div>

      <!-- Row 3: Top Sales Person & Top Customers -->
      <div class="l4e-row">

        <!-- Top Sales Person Table Card (CARD SPECIFIC FILTER) -->
        <div class="l4e-card col-half">
          <div class="card-header">
            <h4>Top Sales Person</h4>
            <div class="card-header-actions">
              <select class="mini-select" t-att-value="state.card_filters.top_sp" t-on-change="(e) => this.setCardFilter('top_sp', e)">
                <option value="1" t-att-selected="(state.card_filters.top_sp || state.filters.month_filter) == '1'">January</option>
                <option value="2" t-att-selected="(state.card_filters.top_sp || state.filters.month_filter) == '2'">February</option>
                <option value="3" t-att-selected="(state.card_filters.top_sp || state.filters.month_filter) == '3'">March</option>
                <option value="4" t-att-selected="(state.card_filters.top_sp || state.filters.month_filter) == '4'">April</option>
                <option value="5" t-att-selected="(state.card_filters.top_sp || state.filters.month_filter) == '5'">May</option>
                <option value="6" t-att-selected="(state.card_filters.top_sp || state.filters.month_filter) == '6'">June</option>
                <option value="7" t-att-selected="(state.card_filters.top_sp || state.filters.month_filter) == '7'">July</option>
                <option value="8" t-att-selected="(state.card_filters.top_sp || state.filters.month_filter) == '8'">August</option>
                <option value="9" t-att-selected="(state.card_filters.top_sp || state.filters.month_filter) == '9'">September</option>
                <option value="10" t-att-selected="(state.card_filters.top_sp || state.filters.month_filter) == '10'">October</option>
                <option value="11" t-att-selected="(state.card_filters.top_sp || state.filters.month_filter) == '11'">November</option>
                <option value="12" t-att-selected="(state.card_filters.top_sp || state.filters.month_filter) == '12'">December</option>
                <option value="all" t-att-selected="(state.card_filters.top_sp || state.filters.month_filter) == 'all'">All Time</option>
              </select>
            </div>
          </div>

          <div class="card-body table-body" style="max-height: 380px; overflow-y: auto;">
            <table class="l4e-table">
              <thead>
                <tr>
                  <th style="width: 30px;">#</th>
                  <th>Salesperson</th>
                  <th class="text-end">Won Revenue (<t t-esc="state.data.currency ? state.data.currency.name : 'USD'"/>)</th>
                  <th class="text-center">Deals Won</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="state.data.top_salespersons || []" t-as="sp" t-key="sp.id">
                  <tr t-on-click="()=>this.open('crm.lead', [['user_id','=',sp.id]], sp.name)">
                    <td><t t-esc="sp.rank"/></td>
                    <td>
                      <div class="user-avatar-wrap">
                        <img t-att-src="sp.avatar" class="user-avatar" alt="Avatar"/>
                        <span><t t-esc="sp.name"/></span>
                      </div>
                    </td>
                    <td class="text-end fw-bold"><t t-esc="sp.won_revenue"/></td>
                    <td class="text-center"><t t-esc="sp.deals_won"/></td>
                  </tr>
                </t>
              </tbody>
            </table>
            <div class="card-footer-link">
              <a href="#" t-on-click.prevent="()=>this.open('crm.lead', [], 'CRM Opportunities', { group_by: ['user_id', 'company_id'] })">View All Salespersons →</a>
            </div>
          </div>
        </div>

        <!-- Top Customers Table Card (CARD SPECIFIC FILTER) -->
        <div class="l4e-card col-half">
          <div class="card-header">
            <h4>Top Customers</h4>
            <div class="card-header-actions">
              <select class="mini-select" t-att-value="state.card_filters.top_cust" t-on-change="(e) => this.setCardFilter('top_cust', e)">
                <option value="1" t-att-selected="(state.card_filters.top_cust || state.filters.month_filter) == '1'">January</option>
                <option value="2" t-att-selected="(state.card_filters.top_cust || state.filters.month_filter) == '2'">February</option>
                <option value="3" t-att-selected="(state.card_filters.top_cust || state.filters.month_filter) == '3'">March</option>
                <option value="4" t-att-selected="(state.card_filters.top_cust || state.filters.month_filter) == '4'">April</option>
                <option value="5" t-att-selected="(state.card_filters.top_cust || state.filters.month_filter) == '5'">May</option>
                <option value="6" t-att-selected="(state.card_filters.top_cust || state.filters.month_filter) == '6'">June</option>
                <option value="7" t-att-selected="(state.card_filters.top_cust || state.filters.month_filter) == '7'">July</option>
                <option value="8" t-att-selected="(state.card_filters.top_cust || state.filters.month_filter) == '8'">August</option>
                <option value="9" t-att-selected="(state.card_filters.top_cust || state.filters.month_filter) == '9'">September</option>
                <option value="10" t-att-selected="(state.card_filters.top_cust || state.filters.month_filter) == '10'">October</option>
                <option value="11" t-att-selected="(state.card_filters.top_cust || state.filters.month_filter) == '11'">November</option>
                <option value="12" t-att-selected="(state.card_filters.top_cust || state.filters.month_filter) == '12'">December</option>
                <option value="all" t-att-selected="(state.card_filters.top_cust || state.filters.month_filter) == 'all'">All Time</option>
              </select>
            </div>
          </div>

          <div class="card-body table-body" style="max-height: 380px; overflow-y: auto;">
            <table class="l4e-table">
              <thead>
                <tr>
                  <th style="width: 30px;">#</th>
                  <th>Customer</th>
                  <th class="text-center">Deals</th>
                  <th class="text-end">Won Revenue (<t t-esc="state.data.currency ? state.data.currency.name : 'USD'"/>)</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="state.data.top_customers || []" t-as="cust" t-key="cust.id">
                  <tr t-on-click="()=>this.open('res.partner', [['id','=',cust.id]], cust.name)">
                    <td><t t-esc="cust.rank"/></td>
                    <td>
                      <div class="cust-icon-wrap">
                        <i class="fa fa-building-o cust-icon"/>
                        <span><t t-esc="cust.name"/></span>
                      </div>
                    </td>
                    <td class="text-center"><t t-esc="cust.deals"/></td>
                    <td class="text-end fw-bold"><t t-esc="cust.won_revenue"/></td>
                  </tr>
                </t>
              </tbody>
            </table>
            <div class="card-footer-link">
              <a href="#" t-on-click.prevent="()=>this.open('sale.order', [['opportunity_id', '!=', false]], 'Sales Orders by Customer', { group_by: ['partner_id', 'company_id'] })">View All Customers →</a>
            </div>
          </div>
        </div>

      </div>

      <!-- Row 4: Upcoming Activities Full-Width Card (CARD SPECIFIC FILTER) -->
      <div class="l4e-row">
        <div class="l4e-card col-full">
          <div class="card-header">
            <h4>Upcoming Activities</h4>
            <div class="card-header-actions">
              <select class="mini-select" t-att-value="state.card_filters.activities" t-on-change="(e) => this.setCardFilter('activities', e)">
                <option value="1" t-att-selected="(state.card_filters.activities || state.filters.month_filter) == '1'">January</option>
                <option value="2" t-att-selected="(state.card_filters.activities || state.filters.month_filter) == '2'">February</option>
                <option value="3" t-att-selected="(state.card_filters.activities || state.filters.month_filter) == '3'">March</option>
                <option value="4" t-att-selected="(state.card_filters.activities || state.filters.month_filter) == '4'">April</option>
                <option value="5" t-att-selected="(state.card_filters.activities || state.filters.month_filter) == '5'">May</option>
                <option value="6" t-att-selected="(state.card_filters.activities || state.filters.month_filter) == '6'">June</option>
                <option value="7" t-att-selected="(state.card_filters.activities || state.filters.month_filter) == '7'">July</option>
                <option value="8" t-att-selected="(state.card_filters.activities || state.filters.month_filter) == '8'">August</option>
                <option value="9" t-att-selected="(state.card_filters.activities || state.filters.month_filter) == '9'">September</option>
                <option value="10" t-att-selected="(state.card_filters.activities || state.filters.month_filter) == '10'">October</option>
                <option value="11" t-att-selected="(state.card_filters.activities || state.filters.month_filter) == '11'">November</option>
                <option value="12" t-att-selected="(state.card_filters.activities || state.filters.month_filter) == '12'">December</option>
                <option value="all" t-att-selected="(state.card_filters.activities || state.filters.month_filter) == 'all'">All Time</option>
              </select>
            </div>
          </div>

          <div class="card-body table-body" style="max-height: 180px; overflow-y: auto;">
            <table class="l4e-table">
              <thead>
                <tr>
                  <th>Activity</th>
                  <th>Customer</th>
                  <th>Salesperson</th>
                  <th>Activity Type</th>
                  <th>Date</th>
                  <th>Time</th>
                  <th class="text-center">Priority</th>
                  <th class="text-center">Status</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="state.data.upcoming_activities || []" t-as="act" t-key="act.id">
                  <tr t-on-click="()=>this.openActivityRecord(act)">
                    <td class="fw-bold"><t t-esc="act.activity"/></td>
                    <td><t t-esc="act.customer"/></td>
                    <td><t t-esc="act.salesperson"/></td>
                    <td><t t-esc="act.type"/></td>
                    <td><t t-esc="act.date"/></td>
                    <td><t t-esc="act.time"/></td>
                    <td class="text-center">
                      <span t-attf-class="prio-badge #{act.priority_class}"><t t-esc="act.priority"/></span>
                    </td>
                    <td class="text-center">
                      <span t-attf-class="status-badge #{act.status_class}"><t t-esc="act.status"/></span>
                    </td>
                  </tr>
                </t>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </t>
</templates>
