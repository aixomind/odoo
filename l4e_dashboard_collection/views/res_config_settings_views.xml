<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l4e_dashboard_collection</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Dashboard Collection" string="Dashboard Collection" data-key="l4e_dashboard_collection" groups="base.group_system">
                    <h2>Dashboard Visibility</h2>
                    <div class="row mt16 o_settings_container" id="l4e_dashboard_visibility_block">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="l4e_show_crm_dashboard"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="l4e_show_crm_dashboard" string="CRM Dashboard"/>
                                <div class="text-muted">
                                    Show CRM Dashboard menu item
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="l4e_show_sales_dashboard"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="l4e_show_sales_dashboard" string="Sales Dashboard"/>
                                <div class="text-muted">
                                    Show Sales Dashboard menu item
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="l4e_show_inventory_dashboard"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="l4e_show_inventory_dashboard" string="Inventory Dashboard"/>
                                <div class="text-muted">
                                    Show Inventory Dashboard menu item
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="l4e_show_account_dashboard"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="l4e_show_account_dashboard" string="Account Dashboard"/>
                                <div class="text-muted">
                                    Show Account/Financial Dashboard menu item
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="l4e_show_amc_dashboard"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="l4e_show_amc_dashboard" string="AMC Dashboard"/>
                                <div class="text-muted">
                                    Show AMC Dashboard menu item
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_l4e_dashboard_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'l4e_dashboard_collection'}</field>
    </record>
</odoo>
