<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order — L4E Dynamic Approval Banner (uses l4e.approval.mixin fields only) -->
    <record id="sale_order_view_form_l4e" model="ir.ui.view">
        <field name="name">sale.order.view.form.l4e.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="alert"
                     invisible="l4e_approval_state != 'pending'">
                    <i class="fa fa-clock-o me-1"/>
                    <strong>Approval Pending</strong> — This sale order is waiting for approval.
                </div>
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="l4e_approval_state != 'refused'">
                    <i class="fa fa-times-circle me-1"/>
                    <strong>Approval Refused</strong> — The approval request was refused. Please review and resubmit.
                </div>
            </xpath>
        </field>
    </record>

    <!-- Legacy approval.request actions removed — approvals module no longer a dependency.
         Discount/sale approval menus are now in l4e_discount_approval module. -->
</odoo>
