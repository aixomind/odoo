<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Product Template Form View Inherit -->
        <record id="view_template_form_inherit_update_lot_serial" model="ir.ui.view">
            <field name="name">product.template.form.inherit.update.lot.serial</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="stock.product_template_form_view_procurement_button"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_product_tmpl_forecast_report']" position="after">
                    <button type="object"
                        name="action_update_lot_serial"
                        attrs="{'invisible': [('type', '!=', 'product')]}"
                        class="oe_stat_button"
                        icon="fa-barcode"
                        groups="stock.group_stock_user">
                        <div class="o_stat_info">
                            <span class="o_stat_value">
                                <field name="untracked_qty"/>
                            </span>
                            <span class="o_stat_text">Update Lot/Serial</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

        <!-- Product Product Form View Inherit -->
        <record id="view_product_form_inherit_update_lot_serial" model="ir.ui.view">
            <field name="name">product.product.form.inherit.update.lot.serial</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="stock.product_form_view_procurement_button"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_product_forecast_report']" position="after">
                    <button type="object"
                        name="action_update_lot_serial"
                        attrs="{'invisible': [('type', '!=', 'product')]}"
                        class="oe_stat_button"
                        icon="fa-barcode"
                        groups="stock.group_stock_user">
                        <div class="o_stat_info">
                            <span class="o_stat_value">
                                <field name="untracked_qty"/>
                            </span>
                            <span class="o_stat_text">Update Lot/Serial</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
