<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Access Management Pro – Odoo 17 Chatter template patch.
        Adds OWL-managed amp-* CSS classes to Chatter root via t-att-class.
        ampState is pre-declared with useState() in setup(), read from
        session.amp_chatter_rules[model] synchronously.
        SCSS targets these classes to hide chatter elements.
    -->
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">

        <!-- Add reactive amp-* classes to the chatter root div -->
        <xpath expr="//div[hasclass('o-mail-Chatter')]" position="attributes">
            <attribute name="t-att-class">{
                'amp-hide-send':        ampState.hideSendMessage,
                'amp-hide-note':        ampState.hideLogNote,
                'amp-hide-activity':    ampState.hideScheduleActivity,
                'amp-hide-followers':   ampState.hideFollowers,
                'amp-hide-attachments': ampState.hideAttachments,
                'amp-hide-chatter':     ampState.hideChatter
            }</attribute>
        </xpath>

        <!-- Belt-and-suspenders: also t-if on Send Message -->
        <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]" position="attributes">
            <attribute name="t-if">props.hasMessageList and !ampState.hideSendMessage</attribute>
        </xpath>

        <!-- Belt-and-suspenders: also t-if on Log Note -->
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="attributes">
            <attribute name="t-if">props.hasMessageList and !ampState.hideLogNote</attribute>
        </xpath>

    </t>

</templates>
