<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_universal_field_update" model="ir.module.category">
        <field name="name">Universal Field Update</field>
        <field name="description">Access rights for Universal Field Update tool.</field>
        <field name="sequence">20</field>
    </record>

    <record id="universal_field_update_privilege" model="res.groups.privilege">
        <field name="name">Universal Field Update</field>
        <field name="category_id" ref="module_category_universal_field_update"/>
    </record>

    <record id="group_universal_field_update_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="universal_field_update_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_universal_field_update_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="universal_field_update_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_universal_field_update_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>