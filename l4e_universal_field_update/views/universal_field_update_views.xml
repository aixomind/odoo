<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="universal_field_updater_view_form" model="ir.ui.view">
        <field name="name">universal.field.updater.form</field>
        <field name="model">universal.field.updater</field>
        <field name="arch" type="xml">
            <form string="Universal Field Update">
                <header>
                    <button name="action_apply_update" string="Apply Field Update" type="object" class="btn-primary" confirm="Are you sure you want to apply this field update to all selected records?" invisible="is_global"/>
                    <button name="action_global_apply" string="Apply Global Update" type="object" class="btn-primary" confirm="Are you sure you want to replace this value everywhere it is referenced?" invisible="not is_global"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Universal Field Update</h1>
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="not warning_message">
                        <field name="warning_message" readonly="1"/>
                    </div>

                    <field name="allowed_model_ids" invisible="1"/>

                    <group>
                        <field name="is_global"/>
                    </group>

                    <!-- ===================== GLOBAL MODE ===================== -->
                    <group string="1. Reference Value" invisible="not is_global">
                        <field name="global_model_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                        <field name="global_model_name" invisible="1"/>
                        <field name="global_old_value_m2o"
                               string="Current Value"
                               widget="dynamic_record_selector"
                               options="{'relation_field': 'global_model_name'}"
                               invisible="not global_model_id"
                               required="is_global and global_model_id"/>
                        <field name="global_new_value_m2o"
                               string="Replace With"
                               widget="dynamic_record_selector"
                               options="{'relation_field': 'global_model_name'}"
                               invisible="not global_model_id"/>
                    </group>

                    <div class="row mb-3" invisible="not is_global or not global_old_value_m2o">
                        <div class="col-12">
                            <button name="action_global_scan" string="Scan All Modules" type="object" class="btn btn-primary"/>
                        </div>
                    </div>

                    <group string="2. Global Matches" invisible="not is_global or not global_line_ids">
                        <group>
                            <div class="o_row">
                                <field name="global_selected_count" readonly="1"/>
                                <span>Model(s) Selected</span>
                            </div>
                        </group>
                    </group>

                    <notebook invisible="not is_global or not global_line_ids">
                        <page name="global_matches_page" string="Matches by Module/Model">
                            <field name="global_line_ids">
                                <list create="false" delete="false" editable="top">
                                    <field name="selected" widget="boolean_toggle"/>
                                    <field name="model_label" readonly="1" string="Model"/>
                                    <field name="field_label" readonly="1" string="Field"/>
                                    <field name="field_ttype" readonly="1" string="Type"/>
                                    <field name="record_count" readonly="1" string="Records Found"/>
                                    <field name="model_name" column_invisible="1"/>
                                    <field name="field_name" column_invisible="1"/>
                                    <field name="records_fetched" column_invisible="1"/>
                                    <field name="selected_record_count" readonly="1" string="Selected" invisible="not records_fetched"/>
                                    <button name="action_select_records" type="object"
                                            string="Select Records" icon="fa-list-ol"
                                            title="Choose which records to update" class="btn-link"
                                            invisible="not record_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <!-- ===================== SINGLE-FIELD MODE ===================== -->
                    <group invisible="is_global">
                        <group string="1. Target Field">
                            <field name="model_id" domain="[('id', 'in', allowed_model_ids)]" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" required="not is_global"/>
                            <field name="model_name"/>
                            <field name="field_id" domain="[('model_id', '=', model_id), ('store', '=', True), ('readonly', '=', False), ('name', 'not in', ('id', 'create_uid', 'create_date', 'write_uid', 'write_date', '__last_update')), ('ttype', 'in', ('char', 'text', 'integer', 'float', 'monetary', 'boolean', 'selection', 'date', 'datetime', 'many2one'))]" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" context="{'show_tech_name': True}" invisible="not model_id" required="not is_global and model_id"/>
                            <field name="field_name" invisible="not field_id"/>
                            <field name="field_type" invisible="not field_id"/>
                            <field name="relation_model" invisible="field_type != 'many2one'"/>
                        </group>

                        <group string="2. Value Change" invisible="not field_id">
                            <field name="update_all"/>

                            <!-- Character / Text / Integer / Float inputs -->
                            <field name="old_value_char"
                                   string="Current Value"
                                   invisible="update_all or field_type in ('boolean', 'selection', 'many2one', 'date', 'datetime')"
                                   required="field_id and not update_all and field_type not in ('boolean', 'selection', 'many2one', 'date', 'datetime')"/>
                            <field name="new_value_char"
                                   string="Replace With"
                                   invisible="field_type in ('boolean', 'selection', 'many2one', 'date', 'datetime')"/>

                            <!-- Boolean inputs -->
                            <field name="old_value_bool"
                                   string="Current Value"
                                   invisible="update_all or field_type != 'boolean'"
                                   required="not update_all and field_type == 'boolean'"/>
                            <field name="new_value_bool"
                                   string="Replace With"
                                   invisible="field_type != 'boolean'"
                                   required="field_type == 'boolean'"/>

                            <!-- Selection inputs -->
                            <field name="old_value_selection_id"
                                   string="Current Value"
                                   options="{'no_create': True, 'no_open': True}"
                                   invisible="update_all or field_type != 'selection'"
                                   required="not update_all and field_type == 'selection'"/>
                            <field name="new_value_selection_id"
                                   string="Replace With"
                                   options="{'no_create': True, 'no_open': True}"
                                   invisible="field_type != 'selection'"/>

                            <!-- Many2one relational inputs (using OWL dynamic record selector widget) -->
                            <field name="old_value_m2o"
                                   string="Current Value"
                                   widget="dynamic_record_selector"
                                   invisible="update_all or field_type != 'many2one'"
                                   required="not update_all and field_type == 'many2one'"/>
                            <field name="new_value_m2o"
                                   string="Replace With"
                                   widget="dynamic_record_selector"
                                   invisible="field_type != 'many2one'"/>

                            <!-- Date inputs -->
                            <field name="old_value_date"
                                   string="Current Value"
                                   invisible="update_all or field_type != 'date'"
                                   required="not update_all and field_type == 'date'"/>
                            <field name="new_value_date"
                                   string="Replace With"
                                   invisible="field_type != 'date'"/>

                            <!-- Datetime inputs -->
                            <field name="old_value_datetime"
                                   string="Current Value"
                                   invisible="update_all or field_type != 'datetime'"
                                   required="not update_all and field_type == 'datetime'"/>
                            <field name="new_value_datetime"
                                   string="Replace With"
                                   invisible="field_type != 'datetime'"/>
                        </group>
                    </group>

                    <group string="3. Filter By (Optional)" invisible="is_global or not field_id">
                        <field name="filter_field_id"
                               domain="[('model_id', '=', model_id), ('store', '=', True), ('ttype', 'in', ('char', 'text', 'integer', 'float', 'monetary', 'boolean', 'selection', 'date', 'datetime', 'many2one'))]"
                               options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                               context="{'show_tech_name': True}"/>
                        <field name="filter_field_name" invisible="not filter_field_id"/>
                        <field name="filter_field_type" invisible="not filter_field_id"/>

                        <field name="filter_value_char"
                               string="Filter Value"
                               invisible="not filter_field_id or filter_field_type in ('boolean', 'selection', 'many2one', 'date', 'datetime')"
                               required="filter_field_id and filter_field_type not in ('boolean', 'selection', 'many2one', 'date', 'datetime')"/>
                        <field name="filter_value_bool"
                               string="Filter Value"
                               invisible="not filter_field_id or filter_field_type != 'boolean'"
                               required="filter_field_id and filter_field_type == 'boolean'"/>
                        <field name="filter_value_selection_id"
                               string="Filter Value"
                               options="{'no_create': True, 'no_open': True}"
                               invisible="not filter_field_id or filter_field_type != 'selection'"
                               required="filter_field_id and filter_field_type == 'selection'"/>
                        <field name="filter_relation_model" invisible="1"/>
                        <field name="filter_value_m2o"
                               string="Filter Value"
                               widget="dynamic_record_selector"
                               options="{'relation_field': 'filter_relation_model'}"
                               invisible="not filter_field_id or filter_field_type != 'many2one'"
                               required="filter_field_id and filter_field_type == 'many2one'"/>
                        <field name="filter_value_date"
                               string="Filter Value"
                               invisible="not filter_field_id or filter_field_type != 'date'"
                               required="filter_field_id and filter_field_type == 'date'"/>
                        <field name="filter_value_datetime"
                               string="Filter Value"
                               invisible="not filter_field_id or filter_field_type != 'datetime'"
                               required="filter_field_id and filter_field_type == 'datetime'"/>
                    </group>

                    <div class="row mb-3" invisible="is_global or not field_id">
                        <div class="col-12">
                            <button name="action_find_records" string="Find Matching Records" type="object" class="btn btn-primary"/>
                        </div>
                    </div>

                    <group string="3. Matching Records" invisible="is_global or not line_ids">
                        <group>
                            <div class="o_row">
                                <field name="record_count" readonly="1"/>
                                <span>Records Found</span>
                                <span class="mx-3">|</span>
                                <field name="selected_count" readonly="1"/>
                                <span>Records Selected</span>
                            </div>
                        </group>
                    </group>

                    <group string="4. Advanced Options" invisible="not is_global and not field_id" groups="l4e_universal_field_update.group_universal_field_update_manager">
                        <field name="force_bypass"/>
                        <div class="alert alert-danger mb-0" role="alert" invisible="not force_bypass" colspan="2">
                            Writes directly to the database via SQL, skipping ORM constraints
                            (e.g. locked/posted document guards), onchange/compute cascades,
                            tracking and workflow triggers. Only use this when you understand
                            exactly what business logic you are bypassing.
                        </div>
                        <field name="delete_old_after_replace" invisible="not is_global"/>
                        <div class="alert alert-warning mb-0" role="alert" invisible="not is_global or not delete_old_after_replace" colspan="2">
                            After replacing every reference, this permanently deletes the old
                            record — only if nothing was left pointing to it. If anything still references the old record
                            (including field types this scan can't see, like Reference fields
                            or attachments), the delete is skipped and the result message
                            explains why.
                        </div>
                    </group>

                    <notebook invisible="is_global or not line_ids">
                        <page name="records_page" string="Matching Records">
                            <field name="line_ids">
                                <list create="false" delete="false" editable="top">
                                    <field name="selected" widget="boolean_toggle"/>
                                    <field name="res_id" readonly="1" string="Record ID"/>
                                    <field name="res_name" readonly="1" string="Record"/>
                                    <field name="current_value_display" readonly="1" string="Current Value"/>
                                    <field name="new_value_display" readonly="1" string="New Value"/>
                                    <field name="target_model_name" invisible="1"/>
                                    <button name="action_open_record" type="object"
                                            string="Open" icon="fa-external-link"
                                            title="Open Record" class="btn-link"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_universal_field_updater" model="ir.actions.act_window">
        <field name="name">Field Update</field>
        <field name="res_model">universal.field.updater</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="universal_field_updater_global_line_view_form" model="ir.ui.view">
        <field name="name">universal.field.updater.global.line.form</field>
        <field name="model">universal.field.updater.global.line</field>
        <field name="arch" type="xml">
            <form string="Select Records">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="model_label" readonly="1" nolabel="1"/> —
                            <field name="field_label" readonly="1" nolabel="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="record_count" readonly="1" string="Total Matches"/>
                        <field name="selected_record_count" readonly="1" string="Selected"/>
                    </group>
                    <field name="model_name" invisible="1"/>
                    <field name="field_name" invisible="1"/>
                    <div class="mb-2">
                        <button name="action_select_all_records" type="object"
                                string="Select All" class="btn btn-secondary btn-sm me-2"/>
                        <button name="action_deselect_all_records" type="object"
                                string="Deselect All" class="btn btn-secondary btn-sm"/>
                    </div>
                    <field name="record_ids">
                        <list editable="top" create="false" delete="false">
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="res_id" readonly="1" string="Record ID"/>
                            <field name="res_name" readonly="1" string="Record"/>
                            <field name="target_model_name" column_invisible="1"/>
                            <button name="action_open_record" type="object"
                                    string="Open" icon="fa-external-link"
                                    title="Open Record" class="btn-link"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_close_selection" string="Done" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
